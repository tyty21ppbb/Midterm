{
  "name": "student/pos-midterm",
  "description": "Complete Point-of-Sale System built with CodeIgniter 4",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" },
    "exclude-from-classmap": ["**/Database/Migrations/**"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-update-cmd": ["@php spark publish"]
  }
}
